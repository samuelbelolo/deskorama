{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskorama.example/feed-page.schema.json",
  "title": "Deskorama Feed page",
  "description": "What a Feed address answers to GET ?cursor=…: the Events after the cursor, oldest first, and where to resume.",
  "type": "object",
  "required": ["events", "next_cursor", "has_more"],
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "next_cursor": {
      "description": "Sent back as ?cursor= on the next poll. null only while the Feed has no Event at all.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "has_more": {
      "type": "boolean",
      "description": "true when more Events wait: the app polls again at once."
    },
    "poll_interval": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds to wait before the next poll, kept between 30 seconds and 15 minutes."
    },
    "gauges": {
      "type": "object",
      "properties": {
        "crowd": {
          "type": "number",
          "minimum": 0
        },
        "daily": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "build": {
          "enum": ["idle", "building", "ready", "error"]
        }
      },
      "description": "Gauge values; those left out keep their value."
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Stable for this Event: a replayed Event with the same id plays once."
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Your own name for the kind of Event. Themes never read it."
        },
        "archetype": {
          "description": "The Role the scene plays. null or left out: the generic Gag, with the label.",
          "oneOf": [
            {
              "enum": [
                "arrival",
                "partner",
                "departure",
                "approval",
                "rejection",
                "abandon",
                "like",
                "celebration",
                "message",
                "publish",
                "usage",
                "money",
                "error",
                "blocked",
                "deploy"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "recognised": {
          "type": "boolean",
          "default": true,
          "description": "false for a kind your backend does not describe: the generic Gag plays."
        },
        "rarity": {
          "enum": ["common", "notable", "rare", "jackpot"],
          "default": "common"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S",
          "description": "The name shown with the Event."
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
          "description": "ISO 8601 with T, then Z or an offset with a colon (+02:00), on a day its month has. The time of the poll when left out."
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "fr": {
              "$ref": "#/$defs/text"
            },
            "en": {
              "$ref": "#/$defs/text"
            }
          },
          "description": "The words in French, English or both; one language is used for both."
        },
        "step": {
          "enum": ["started", "succeeded", "failed"],
          "description": "Deploy Events only."
        },
        "gauge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "by"],
          "properties": {
            "role": {
              "enum": ["crowd", "daily", "total"]
            },
            "by": {
              "type": "number"
            }
          },
          "description": "How the Event moves a Gauge."
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S",
          "description": "The plain fact."
        },
        "detail": {
          "type": "string",
          "maxLength": 200,
          "description": "One concrete line, never personal data. Empty when left out."
        },
        "tag": {
          "type": "string",
          "maxLength": 16,
          "description": "About 12 characters to paint on a prop. Empty when left out."
        }
      }
    }
  }
}
